 namespace VideoCore {
 
+namespace Detail {
+
+/// True when the host is close to running out of memory. Only implemented for Linux and Android,
+/// where the kernel kills the biggest app before swapping, so a phone with 2 GB of RAM needs this.
+inline bool HostMemoryIsLow() {
+#if defined(__linux__)
+    std::FILE* file = std::fopen("/proc/meminfo", "r");
+    if (file == nullptr) {
+        return false;
+    }
+    unsigned long long total_kb = 0;
+    unsigned long long available_kb = 0;
+    char line[128];
+    while (std::fgets(line, sizeof(line), file) != nullptr) {
+        std::sscanf(line, "MemTotal: %llu kB", &total_kb);
+        std::sscanf(line, "MemAvailable: %llu kB", &available_kb);
+        if (total_kb != 0 && available_kb != 0) {
+            break;
+        }
+    }
+    std::fclose(file);
+    if (total_kb == 0 || available_kb == 0) {
+        return false;
+    }
+    // Less than a tenth of the RAM, and under 300 MB, is available.
+    return available_kb * 10 < total_kb && available_kb < 300ULL * 1024ULL;
+#else
+    return false;
+#endif
+}
+
+} // namespace Detail
